{
  "name": "nutrition-app",
  "version": "1.0.0",
  "description": "Application de suivi nutritionnel",
  "main": "app.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check:syntax": "for f in $(ls *.js | grep -v '\\.test\\.js$') pb/pb_hooks/*.js pb/pb_migrations/*.js; do node --check \"$f\" || exit 1; done",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.5"
  }
}
